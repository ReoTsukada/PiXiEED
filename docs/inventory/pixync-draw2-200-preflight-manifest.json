  "designGate": {
    "status": "DURABLE_TRANSPORT_DESIGN_GATE_READY_FOR_TERRA",
    "rootCause": "190 validates a provider ACK but 120 still reconstructs a committed envelope from local state and a revision, so the durable transport coordinator must bind and persist the authoritative ACK before ordered application",
    "structuralCorrection": "keep durable transport internal, add an authoritative ACK journal API, restore OrderKeeper from canonical committed receipts, and sequence enqueue before submit and inbox persistence before apply",
