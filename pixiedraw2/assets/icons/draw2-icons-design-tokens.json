{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "PiXiEEDraw2 Icon System Tokens",
  "version": "0.4.0",
  "primitive": {
    "icon/grid": { "$type": "number", "$value": 24 },
    "icon/safe-area": { "$type": "number", "$value": 20 },
    "icon/stroke": { "$type": "number", "$value": 2 },
    "icon/corner-small": { "$type": "number", "$value": 1 },
    "icon/corner-medium": { "$type": "number", "$value": 2 },
    "icon/size-16": { "$type": "number", "$value": 16 },
    "icon/size-20": { "$type": "number", "$value": 20 },
    "icon/size-24": { "$type": "number", "$value": 24 },
    "icon/size-32": { "$type": "number", "$value": 32 },
    "icon/gap": { "$type": "number", "$value": 8 }
  },
  "semantic": {
    "icon/color/default": {
      "$type": "color",
      "$value": "currentColor",
      "codeSyntax": { "WEB": "currentColor" }
    },
    "icon/color/active": {
      "$type": "color",
      "$value": "var(--draw2-accent)"
    },
    "icon/color/disabled": {
      "$type": "color",
      "$value": "currentColor",
      "opacity": 0.42
    },
    "icon/color/focus": {
      "$type": "color",
      "$value": "var(--draw2-focus)"
    },
    "icon/color/warning": {
      "$type": "color",
      "$value": "var(--draw2-warning)"
    },
    "icon/color/danger": {
      "$type": "color",
      "$value": "var(--draw2-danger)"
    },
    "icon/state/default": {
      "$type": "string",
      "$value": "Default"
    },
    "icon/state/active": {
      "$type": "string",
      "$value": "Active"
    },
    "icon/state/hover": {
      "$type": "string",
      "$value": "Hover"
    },
    "icon/state/disabled": {
      "$type": "string",
      "$value": "Disabled"
    }
  },
  "component": {
    "name": "Tool Icon / {Tool Name}",
    "properties": {
      "State": ["Default", "Active", "Hover", "Disabled"],
      "Size": [16, 20, 24, 32],
      "Color": "Current Color"
    },
    "architecture": "glyph component + Tool Icon / Control wrapper with INSTANCE_SWAP"
  },
  "rendering": {
    "viewBox": "0 0 24 24",
    "shapeRendering": "geometricPrecision",
    "lineCap": "round",
    "lineJoin": "round",
    "opticalCorrection": true,
    "fillDefault": false
  }
}
