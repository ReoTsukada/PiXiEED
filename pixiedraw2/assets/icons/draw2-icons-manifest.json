{
  "name": "PiXiEEDraw2 Original Icon Library",
  "version": "0.4.0",
  "style": "outline-tool-system",
  "viewBox": "0 0 24 24",
  "geometry": {
    "grid": 24,
    "safeArea": 20,
    "strokeWidth": 2,
    "lineCap": "round",
    "lineJoin": "round",
    "shapeRendering": "geometricPrecision",
    "cornerRadius": "1-2px",
    "opticalCorrection": true,
    "minimumNegativeSpace": "2px",
    "supportedSizes": [16, 20, 24, 32],
    "defaultSize": 24
  },
  "stateModel": {
    "component": "Tool Icon / {Tool Name}",
    "variants": ["Default", "Active", "Hover", "Disabled"],
    "properties": {
      "Size": [16, 20, 24, 32],
      "Color": "Current Color"
    },
    "defaultColor": "currentColor",
    "activeRule": "Active/強調時だけfillまたはアクセント色を許可。通常状態はoutlineを優先する。",
    "disabledRule": "意味が消えない濃度までcurrentColorの不透明度を下げ、形状は変えない。"
  },
  "referenceBasis": [
    "既存104 ID・名称・操作イメージ・基本モチーフを維持",
    "Figma Icon System / SF Symbols / Adobe / Aseprite / Affinityの共通視認ルール",
    "Google Material Iconsのsimple/minimal・common size最適化方針"
  ],
  "primitiveShapeRule": "四角形・三角形・円・必要最小限の曲線を同一グリッド上で接続し、不自然な継ぎ目や飾りを入れない。",
  "safeFrameRule": "24px viewBoxの内側20pxをsafe areaとし、strokeを含む外周をx2..22・y2..22に収める。",
  "outlineRule": "通常状態は2px outline、round cap、round join。塗りは操作の意味または16px判別に不可欠な場合だけ例外化する。",
  "directionRule": "矢印・再生・ズーム・ミラーは先端を実際の操作方向へ向け、軸線と先端の接点を同一座標で作る。",
  "toolShapeRule": "Drawing系は既存の標準モチーフを保ち、ペン・ブラシ・消しゴム・塗りつぶしは斜め軸と用途が16pxで読める密度にする。",
  "historyShapeRule": "Undo/Redoは単方向矢印、Rollbackは折り返し矢印として描き分け、円形reloadと混同させない。",
  "fillExceptions": {
    "operationFill": ["icon-rect-fill", "icon-ellipse-fill", "icon-circle-fill"],
    "16pxRecognition": [
      "icon-play", "icon-pause", "icon-stop", "icon-record", "icon-more",
      "icon-brush", "icon-color", "icon-select-color", "icon-manual", "icon-opacity"
    ],
    "connectedAccent": [
      "icon-warning", "icon-sync-connecting", "icon-sync-online", "icon-sync-error"
    ]
  },
  "representativeIcons": [
    "icon-select", "icon-pan", "icon-pen", "icon-brush", "icon-eraser",
    "icon-fill", "icon-zoom-in", "icon-manual", "icon-color", "icon-layers"
  ],
  "componentArchitecture": {
    "glyph": "既存IDごとのTool Icon / {Tool Name}コンポーネント",
    "stateSizeWrapper": "Tool Icon / ControlのSize×State variant",
    "iconSelection": "INSTANCE_SWAPでglyphを差し替え、104アイコン×16variantの爆発を避ける。",
    "sizes": "16 / 20 / 24 / 32",
    "states": "Default / Active / Hover / Disabled"
  },
  "functionalCount": 100,
  "reserveCount": 4,
  "categories": {
    "common": [
      "icon-commands", "icon-undo", "icon-redo", "icon-rollback", "icon-export", "icon-import",
      "icon-file", "icon-folder", "icon-image", "icon-check", "icon-close", "icon-add",
      "icon-remove", "icon-delete", "icon-duplicate", "icon-edit", "icon-more", "icon-help",
      "icon-warning", "icon-pin", "icon-link", "icon-star", "icon-inspector"
    ],
    "viewport": [
      "icon-chevron-left", "icon-chevron-right", "icon-chevron-up", "icon-chevron-down",
      "icon-collapse", "icon-expand", "icon-shrink", "icon-focus", "icon-view", "icon-center",
      "icon-pan", "icon-manual", "icon-border", "icon-anchor", "icon-anchor-nw", "icon-anchor-n",
      "icon-anchor-ne", "icon-anchor-w", "icon-anchor-e", "icon-anchor-sw", "icon-anchor-s", "icon-anchor-se"
    ],
    "drawing": [
      "icon-pen", "icon-brush", "icon-eraser", "icon-fill", "icon-eyedropper", "icon-line",
      "icon-rect", "icon-rect-fill", "icon-ellipse", "icon-ellipse-fill", "icon-circle",
      "icon-circle-fill", "icon-select", "icon-select-color", "icon-color", "icon-color-mode",
      "icon-tools", "icon-fx", "icon-opacity", "icon-invert", "icon-flip-horizontal",
      "icon-flip-vertical", "icon-rotate-ccw", "icon-rotate-cw", "icon-rotate-180"
    ],
    "layersTimelineAnimation": [
      "icon-layers", "icon-eye", "icon-eye-off", "icon-lock", "icon-unlock", "icon-timeline",
      "icon-play", "icon-pause", "icon-stop", "icon-loop", "icon-bounce", "icon-sequence",
      "icon-onion", "icon-sheet", "icon-power-on", "icon-power-off"
    ],
    "audio": [
      "icon-note", "icon-wave", "icon-instrument", "icon-microphone", "icon-record"
    ],
    "mirror": ["icon-mirror-diagonal-down", "icon-mirror-diagonal-up"],
    "zoom": ["icon-zoom-out", "icon-zoom-in", "icon-fit-canvas"],
    "pixync": ["icon-sync-local", "icon-sync-connecting", "icon-sync-online", "icon-sync-error"]
  },
  "reserve": ["icon-save", "icon-search", "icon-skip-previous", "icon-skip-next"],
  "export": {
    "source": "draw2-icons.svg",
    "format": "SVG symbols",
    "viewBox": "0 0 24 24",
    "colorContract": "currentColor",
    "rendering": "geometricPrecision"
  },
  "optionalCompatibility": [
    {
      "id": "icon-opacity",
      "reason": "現在のOnion Skin・layer opacity UIで参照されるため、機能廃止までは意味を維持する。"
    }
  ]
}
