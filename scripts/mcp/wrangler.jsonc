{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixieed-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAW_SESSIONS",
        "class_name": "DrawSessionDO"
      },
      {
        "name": "DRAW_ADMISSION",
        "class_name": "DrawAdmissionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-draw-sessions",
      "new_sqlite_classes": [
        "DrawSessionDO"
      ]
    },
    {
      "tag": "v2-draw-admission",
      "new_sqlite_classes": [
        "DrawAdmissionDO"
      ]
    }
  ]
}
