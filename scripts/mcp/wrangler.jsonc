{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixieed-mcp",
  "main": "store-worker.mjs",
  "vars": {
    "OPENAI_APPS_CHALLENGE": "B-DG7SQSXieJq38EX4z1uUZ-jeQoD43_IUACwmKX9oI"
  },
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAW_SESSIONS",
        "class_name": "DrawSessionDO"
      },
      {
        "name": "DRAW_ADMISSION",
        "class_name": "DrawAdmissionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-draw-sessions",
      "new_sqlite_classes": [
        "DrawSessionDO"
      ]
    },
    {
      "tag": "v2-draw-admission",
      "new_sqlite_classes": [
        "DrawAdmissionDO"
      ]
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "ec149d644c0347e89b4ae9b4a350a0d0"
    }
  ]
}
