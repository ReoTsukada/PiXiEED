# Edge Function側だけに置く設定です。secret keyは公開サイトへコピーしません。
SUPABASE_URL=https://your-project-ref.supabase.co
# Hosted FunctionsではSupabase標準のキー辞書を優先します。
# ローカル実行時だけ必要なら、以下の2つを設定してください。
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# 本番サイトのOrigin。複数ある場合はカンマ区切り。未設定時はローカル4173だけ許可します。
PUBLIC_SITE_ORIGIN=https://your-public-site.example

# Supabase Authの管理者ユーザーIDをカンマ区切りで指定します。
# 代わりにAuthユーザーのapp_metadataへ {"role":"admin"} を設定しても構いません。
SUPABASE_ADMIN_USER_IDS=your-admin-user-uuid
